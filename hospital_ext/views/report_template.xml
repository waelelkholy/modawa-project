    <record id="action_report_tpn_form" model="ir.actions.report">
        <field name="name">TPN Form Report</field>
        <field name="model">tpn.form</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hospital_ext.report_tpn_form_document</field>
        <field name="report_file">hospital_ext.report_tpn_form_document</field>
        <field name="binding_model_id" ref="hospital_ext.model_tpn_form"/>
        <field name="paperformat_id" ref="paperformat_po_req"/>
        <field name="binding_type">report</field>
    </record>

</odoo>