<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="internal_layout_po">
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
    </template>

    <template id="report_tpn_form_document">
        <t t-call="web.html_container">
            <t t-call="hospital_ext.internal_layout_po">

                <t t-foreach="docs" t-as="doc">
                    <div class="page" style="border: 2px solid black">
                        <!-- Header -->
                        <h4 class="text-center">KINGDOM OF SAUDI ARABIA</h4>
                        <h4 class="text-center">MINISTRY OF HEALTH</h4>
                        <h4 class="text-center">Pharmaceutical Services IV Admixture and TPN Department</h4>
                        <h4 class="text-center">TOTAL PARENTERAL NUTRITION NEONATAL FORM</h4>

                        <!-- Prescriber and Patient Information -->
                        <table style=" border: 1px solid black;width: 90%; border-collapse: collapse; margin-bottom: 10px;margin-left: 5%;margin-right: 5%;" border="1">
                            <tr style=" border: 1px solid black;">
                                <td colspan="2"><strong>Name:</strong> <t t-esc="doc.name"/></td>
                                <td colspan="2"><strong>Hospital No.:</strong> <t t-esc="doc.hospital_no"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td colspan="2"><strong>Nationality:</strong> <t t-esc="doc.nationality"/></td>
                                <td colspan="2"><strong>Treating Physician:</strong> <t t-esc="doc.treating_physician"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td><strong>Ward:</strong> <t t-esc="doc.ward"/></td>
                                <td><strong>Age:</strong> <t t-esc="doc.age"/> days</td>
                                <td><strong>Weight:</strong> <t t-esc="doc.weight"/> kg</td>
                                <td><strong>Height:</strong> <t t-esc="doc.height"/> cm</td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td colspan="4"><strong>Diagnosis:</strong> <t t-esc="doc.diagnosis"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td colspan="4"><strong>TPN Indication(s):</strong> <t t-esc="doc.tpn_indications"/></td>
                            </tr>
                        </table>

                        <!-- TPN Details -->
                        <h5 style="margin-left: 5%;">TPN Prescription Details</h5>
                        <table style="width: 90%; border-collapse: collapse; margin-bottom: 10px;margin-left: 5%;margin-right: 5%;" border="1">
                            <tr style="border: 1px solid black;">
                                <td style="background-color: #d3d3d3;" rowspan="3">No#1</td>
                                <td><strong>Day(s) of TPN:</strong></td>
                                <td><t t-esc="doc.tpn_day"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td><strong>Date:</strong></td>
                                <td><t t-esc="doc.date"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td><strong>Route:</strong></td>
                                <td><t t-esc="dict(doc._fields['tpn_route'].selection).get(doc.tpn_route)"/></td>
                            </tr>

                        </table>

                        <!-- Nutritional Details -->
                        <div class="nutritional-details">
                            <h5 style="margin-left: 5%;">Nutritional Details</h5>
                            <table style="width: 90%; border: 1px solid black; border-collapse: collapse;margin-bottom: 10px;margin-left: 5%;margin-right: 5%;">
                                <tr style="border: 1px solid black;">
                                    <td style="background-color: #d3d3d3;">No#2</td>
                                    <th style="text-align:left">Dextrose (mg/kg/min)</th>
                                    <td style="text-align:center"><t t-esc="doc.dextrose_mg_kg_min"/></td>
                                    <th style="text-align:left">Dextrose (gm/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.dextrose_gm_day"/></td>

                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="background-color: #d3d3d3;">No#3</td>
                                    <th  style="text-align:left">Amino Acids (gm/kg/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.dextrose_gm_day"/></td>
                                    <th  style="text-align:left">Amino Acids (gm/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.amino_acids_gm_day"/></td>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="background-color: #d3d3d3;">No#4</td>

                                    <th  style="text-align:left">Fat Emulsion 20% (gm/kg/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.fat_emulsion_gm_kg_day"/></td>

                                    <th  style="text-align:left">Fat Emulsion 20% (gm/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.fat_emulsion_gm_day"/></td>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="background-color: #d3d3d3;">No#5</td>

                                    <th  style="text-align:left">Total Fluid Intake (ml/kg/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.total_fluid_intake"/></td>
                                    <th  style="text-align:left">Total Fluid Intake (ml/hour)</th>
                                    <td style="text-align:center"><t t-esc="doc.total_fluid_intake_ml_hr"/></td>
                                </tr>
                                <tr style="border: 1px solid black;">
                                    <td style="background-color: #d3d3d3;">No#6</td>

                                    <th  style="text-align:left">Total Fluid Intake (ml/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.total_fluid_intake_ml_day"/></td>
                                    <th  style="text-align:left">Total Volume of TPN (ml/day)</th>
                                    <td style="text-align:center"><t t-esc="doc.total_volume_tpn"/></td>
                                </tr>

                            </table>
                        </div>



                        <!-- Additives Section -->
                        <!-- Additives Section -->
                        <div class="additives-section">
                            <h5 style="margin-left: 5%;">Additives</h5>
                            <table style="width: 90%; border: 1px solid black; border-collapse: collapse; margin-bottom: 10px;margin-left: 5%;margin-right: 5%;">
                                <tr style="border: 1px solid black;">
                                    <td></td>
                                    <th style="background-color: #d3d3d3;">No#7</th>
                                    <td></td>
                                    <td></td>
                                </tr>
                                <tr style="background-color: #d3d3d3;border: 1px solid black; ">
                                    <th>Additive</th>
                                    <th>Prescribed Amt/Day</th>
                                    <th>Maintenance Range</th>
                                    <th>Notes</th>
                                </tr>
                                <t t-foreach="[
                        ('Sodium', doc.sodium, doc.sodium_range, doc.sodium_notes),
                        ('Potassium', doc.potassium, doc.potassium_range, doc.potassium_notes),
                        ('Calcium', doc.calcium, doc.calcium_range, doc.calcium_notes),
                        ('Magnesium', doc.magnesium, doc.magnesium_range, doc.magnesium_notes),
                        ('Phosphate', doc.phosphate, doc.phosphate_range, doc.phosphate_notes),
                        ('Chloride', doc.chloride, doc.chloride_range, doc.chloride_notes),
                        ('Acetate', doc.acetate, doc.acetate_range, doc.acetate_notes),
                        ('Fat Soluble Vitamins', doc.fat_soluble_vitamins, doc.fat_soluble_vitamins_range, doc.fat_soluble_vitamins_notes),
                        ('Water Soluble Vitamins', doc.water_soluble_vitamins, doc.water_soluble_vitamins_range, doc.water_soluble_vitamins_notes),
                        ('Trace Elements', doc.trace_elements, doc.trace_elements_range, doc.trace_elements_notes),
                        ('Heparin', doc.heparin, doc.heparin_range, doc.heparin_notes),
                    ]" t-as="additive">
                                    <tr style="border: 1px solid black; ">
                                        <td style="text-align:center"><t t-esc="additive[0]"/></td>
                                        <td style="text-align:center"><t t-esc="additive[1]"/></td>
                                        <td style="text-align:center"><t t-esc="additive[2]"/></td>
                                        <td style="text-align:center"><t t-esc="additive[3]"/></td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                        <!-- Pharmacy and Calculations -->
                        <h5 style="margin-left: 5%;">Pharmacy Information and Calculations</h5>
                        <table style="width: 90%; border-collapse: collapse; margin-bottom: 10px;margin-left: 5%;margin-right: 5%;" border="1">
                            <tr style="border: 1px solid black;">
                                <td rowspan="2" style="background-color: #d3d3d3;">No#8</td>
                                <td><strong>TPN Rate (ml/hr):</strong></td>
                                <td><t t-esc="doc.tpn_rate"/></td>
                                <td><strong>Total TPN Fluid Rate (ml/hr):</strong></td>
                                <td><t t-esc="doc.total_tpn_fluid_rate"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td><strong>Non-Protein Calories (kcal/day):</strong></td>
                                <td><t t-esc="doc.non_protein_calories"/></td>
                                <td><strong>Nitrogen Ratio:</strong></td>
                                <td><t t-esc="doc.nitrogen_ratio"/></td>
                            </tr>
                        </table>

                        <!-- Prescriber Section -->
                        <h5 style="margin-left: 5%;">Prescriber and Technician Information</h5>
                        <table style="width: 90%; border-collapse: collapse; margin-left: 5%;margin-right: 5%;" border="1">
                            <tr style="border: 1px solid black;">
                                <td><strong>Prescriber Name:</strong></td>
                                <td><t t-esc="doc.prescriber_name"/></td>
                                <td><strong>Prescriber ID:</strong></td>
                                <td><t t-esc="doc.prescriber_id"/></td>
                            </tr>
                            <tr style="border: 1px solid black;">
                                <td><strong>Nurse Name:</strong></td>
                                <td><t t-esc="doc.nurse_name"/></td>
                                <td><strong>Technician Name:</strong></td>
                                <td><t t-esc="doc.pharmacy_technician"/></td>
                            </tr>
                        </table>

                        <p  style="margin-left: 5%;"><strong>Notes:</strong> <t t-esc="doc.notes"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <record id="paperformat_po_req" model="report.paperformat">
        <field name="name">Tax Invoice Paper Format</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">1</field>
        <field name="margin_right">1</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>
