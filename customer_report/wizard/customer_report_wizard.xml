<!--            <field name="help">Statement Of Account</field>-->
<!--            <field name="binding_model_id" ref="base.model_res_partner" />-->
<!--        </record>-->

        <menuitem id="cr_menu" name="Customer Report" parent="account.menu_finance_reports"
                  action="cr_action"/>

    </data>
</odoo>
