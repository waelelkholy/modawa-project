<odoo>
    <record id="view_tpn_form_form" model="ir.ui.view">
        <field name="name">tpn.form.form</field>
        <field name="model">tpn.form</field>
        <field name="arch" type="xml">
            <form string="Total Parenteral Nutrition Form">
                <header>
                    <button name="action_approve" type="object" string="Approve" states="draft" groups="hospital_ext.group_tpm"/>
                    <button name="action_reject" type="object" string="Reject" states="draft"  groups="hospital_ext.group_tpm"/>
                    <button name="action_reset" type="object" string="Reset to Draft" states="reject"  groups="hospital_ext.group_tpm"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group string="Patient Details" colspan="2">
                        <group>
                            <field name="seq_no" readonly="1"/>
                            <field name="name"/>
                            <field name="portal_user_id"/>
                            <field name="hospital_no"/>
                            <field name="nationality"/>
                            <field name="treating_physician"/>
                        </group>
                        <group>
                            <field name="ward"/>
                            <field name="age"/>
                            <field name="weight"/>
                            <field name="height"/>
                        </group>
                    </group>

                    <group>
                        <group string="TPN Details">
                            <field name="diagnosis"/>
                            <field name="tpn_indications"/>
                        </group>

                        <group string="No#1">

                            <field name="date"/>
                            <field name="tpn_day"/>
                            <field name="tpn_route"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Nutritional Requirements">
                            <group>
                                <group string="No#2">
                                    <field name="dextrose_mg_kg_min"/>
                                    <field name="dextrose_gm_day"/>
                                </group>
                                <group string="No#3">
                                    <field name="amino_acids_gm_kg_day"/>
                                    <field name="amino_acids_gm_day"/>
                                </group>
                                <group string="No#4">
                                    <field name="fat_emulsion_gm_kg_day"/>
                                    <field name="fat_emulsion_gm_day"/>
                                </group>
                                <group string="No#5">
                                    <field name="total_fluid_intake"/>
                                    <field name="total_fluid_intake_ml_hr"/>
                                    <field name="total_fluid_intake_ml_day"/>
                                </group>
                                <group string="No#6">
                                    <field name="total_volume_tpn"/>
                                </group>
                            </group>
                        </page>

                        <page string="Additives">
                            <group string="No#7">
                                <!-- Sodium -->
                                <group string="Sodium">
                                    <field name="sodium"/>
                                    <field name="sodium_range" readonly="1"/>
                                    <field name="sodium_notes" readonly="1"/>
                                </group>

                                <!-- Potassium -->
                                <group string="Potassium">
                                    <field name="potassium"/>
                                    <field name="potassium_range" readonly="1"/>
                                    <field name="potassium_notes" readonly="1"/>
                                </group>

                                <!-- Calcium -->
                                <group string="Calcium">
                                    <field name="calcium"/>
                                    <field name="calcium_range" readonly="1"/>
                                    <field name="calcium_notes" readonly="1"/>
                                </group>

                                <!-- Magnesium -->
                                <group string="Magnesium">
                                    <field name="magnesium"/>
                                    <field name="magnesium_range" readonly="1"/>
                                    <field name="magnesium_notes" readonly="1"/>
                                </group>

                                <!-- Phosphate -->
                                <group string="Phosphate">
                                    <field name="phosphate"/>
                                    <field name="phosphate_range" readonly="1"/>
                                    <field name="phosphate_notes" readonly="1"/>
                                </group>

                                <!-- Chloride -->
                                <group string="Chloride">
                                    <field name="chloride"/>
                                    <field name="chloride_range" readonly="1"/>
                                    <field name="chloride_notes" readonly="1"/>
                                </group>

                                <!-- Acetate -->
                                <group string="Acetate">
                                    <field name="acetate"/>
                                    <field name="acetate_range" readonly="1"/>
                                    <field name="acetate_notes" readonly="1"/>
                                </group>

                                <!-- Fat Soluble Vitamins -->
                                <group string="Fat Soluble Vitamins">
                                    <field name="fat_soluble_vitamins"/>
                                    <field name="fat_soluble_vitamins_range" readonly="1"/>
                                    <field name="fat_soluble_vitamins_notes" readonly="1"/>
                                </group>

                                <!-- Water Soluble Vitamins -->
                                <group string="Water Soluble Vitamins">
                                    <field name="water_soluble_vitamins"/>
                                    <field name="water_soluble_vitamins_range" readonly="1"/>
                                    <field name="water_soluble_vitamins_notes" readonly="1"/>
                                </group>

                                <!-- Trace Elements -->
                                <group string="Trace Elements">
                                    <field name="trace_elements"/>
                                    <field name="trace_elements_range" readonly="1"/>
                                    <field name="trace_elements_notes" readonly="1"/>
                                </group>

                                <!-- Heparin -->
                                <group string="Heparin">
                                    <field name="heparin"/>
                                    <field name="heparin_range" readonly="1"/>
                                    <field name="heparin_notes" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Pharmacy Details">
                            <group>
                                <field name="base_solution_dextrose"/>
                                <field name="base_solution_amino"/>
                                <field name="base_solution_water"/>
                                <field name="additives_sodium_chloride"/>
                                <field name="additives_potassium_chloride"/>
                                <field name="additives_calcium_gluconate"/>
                                <field name="additives_magnesium_sulfate"/>
                                <field name="additives_sodium_phosphate"/>
                                <field name="additives_vitamins"/>
                                <field name="additives_trace_elements"/>
                            </group>
                        </page>

                        <page string="Calculated Fields">
                            <group string="No#8">
                                <field name="tpn_rate"/>
                                <field name="total_tpn_fluid_rate"/>
                                <field name="non_protein_calories"/>
                                <field name="nitrogen_ratio"/>
                            </group>
                        </page>
                    </notebook>

                    <group string="Prescriber Information">
                        <field name="prescriber_name"/>
                        <field name="prescriber_id"/>
                        <field name="nurse_name"/>
                        <field name="pharmacy_technician"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_tpn_form" model="ir.actions.act_window">
        <field name="name">TPN Forms</field>
        <field name="res_model">tpn.form</field>
        <field name="view_mode">tree,form</field>
    </record>


    <record id="tpn_form_rule_portal" model="ir.rule">
        <field name="name">Portal User Access to TPN Forms</field>
        <field name="model_id" ref="model_tpn_form"/>
        <field name="domain_force">[('portal_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <menuitem id="menu_tpn_root" name="TPN Forms" sequence="10"/>
    <menuitem id="menu_tpn_form" name="Forms" parent="menu_tpn_root" action="action_tpn_form"/>



    <template id="portal_my_home_tpm" name="Show TPN Records" inherit_id="portal.portal_my_home" customize_show="True" priority="100">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" href="/my/tpn_forms" title="TPN Records">
                TPN Records
                <span class="badge text-bg-secondary rounded-pill" data-placeholder_count="1">
                    <i class="fa fa-spin fa-circle-o-notch"></i>
                </span>
            </a>
        </xpath>
    </template>
</odoo>